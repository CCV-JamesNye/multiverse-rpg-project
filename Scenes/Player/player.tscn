[sub_resource type="GDScript" id="GDScript_xpcdj"]
resource_name = "player_healthbar"
script/source = "extends ProgressBar

@onready var player: Player = $\"../..\"

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	player.health_update.connect(update_bar)
	pass

func update_bar(health: int) -> void:
	value = health
"

